# The I AM Network - Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Get your PostgreSQL connection string from Neon or your local PostgreSQL instance
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://username:password@your-db-host.com/your-database

# LLM Provider API Keys
# =====================

# OpenAI API (Zero's main brain - GPT 5.1 for routing, other OpenAI models for characters)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# OpenRouter API (for Grok, Claude, Llama and other models via unified API)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Google Gemini API (optional - for Gemini-based characters like EchoPulse, Horizon)
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_GENAI_API_KEY=your-google-genai-api-key-here
# Alternative name (both work):
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key-here

# Replicate API (for AI image generation - avatars and hero art)
# Get your API key from: https://replicate.com/account/api-tokens
REPLICATE_API_KEY=your-replicate-api-key-here

# Optional: Session Secret (for user sessions)
SESSION_SECRET=your-random-secret-key-change-this-in-production

# Google Cloud Storage (for episodes, shorts, recordings)
# ========================================================
GCS_BUCKET_NAME=iam-network-media
GCS_PROJECT_ID=your-gcp-project-id
# Path to GCP service account JSON file (or set GOOGLE_APPLICATION_CREDENTIALS env var)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# Supabase (alternative for storage + auth)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
